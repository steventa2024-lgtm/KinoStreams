# Authentication & Session Security
# Secret key for signing 30-day HTTP-only session cookies and email verification tokens
AUTH_SECRET=

# Transactional Email Delivery via Resend (optional in local dev; logs link & code to console if omitted)
RESEND_API_KEY=
EMAIL_FROM=KinoStream <onboarding@resend.dev>

# Google OAuth 2.0 (optional; add both to enable "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TMDB API Key (v3 API key or v4 Read Access Token)
# Optional: KinoStream includes curated public-domain & FTA fallback data if omitted.
TMDB_API_KEY=

# Optional 4-digit PIN lock for the app (leave empty to disable PIN gate)
KINO_PIN=
KINO_PIN_SECRET=change-this-to-a-random-32-char-secret

# Optional default M3U8 playlist & XMLTV EPG URLs
NEXT_PUBLIC_DEFAULT_M3U_URL=
NEXT_PUBLIC_DEFAULT_EPG_URL=

# Optional sports event stream provider endpoint (queried server-side by normalized team names & date)
SPORTS_STREAM_API_URL=

# Site Branding
NEXT_PUBLIC_SITE_NAME=KinoStream
